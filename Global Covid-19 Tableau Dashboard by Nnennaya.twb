              <calculation class='tableau' formula='// Real Countries have only 3-letter ISO codes&#13;&#10;// This is to distinguish and group Countries from others.&#13;&#10;&#13;&#10;IF LEFT([iso_code],4)= &quot;OWID&quot;&#13;&#10;THEN &quot;Other Regions&quot;&#13;&#10;ELSE &quot;Country&quot;&#13;&#10;END' />
