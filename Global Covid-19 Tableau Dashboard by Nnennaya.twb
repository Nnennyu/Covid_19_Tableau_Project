    <worksheet name='Continent Vaccination and Case Fetality Rates'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Bold' fontsize='10'>Continent Vaccination and Case Fatality Rates</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='owid-covid-data' name='federated.1nblp2l1vnqjwq16ycivw16kzet4' />
          </datasources>
          <datasource-dependencies datasource='federated.1nblp2l1vnqjwq16ycivw16kzet4'>
            <column caption='Distint Population' datatype='integer' name='[Calculation_1214984076730368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// This helps to calculate the &#13;&#10;//maximum population for each selected location.&#13;&#10;&#13;&#10;{ FIXED [location]: MAX([population]) }' />
            </column>
            <column caption='Vaccination Rate' datatype='real' name='[Calculation_1214984083488771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Total vaccinations are cummulative values&#13;&#10;MAX([total_vaccinations])/SUM([Calculation_1214984076730368])' />
            </column>
            <column caption='Case Fatality Rate' datatype='real' name='[Calculation_1214984084344836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//The proportion of deaths as a result of this infection cases&#13;&#10;&#13;&#10;MAX([total_deaths])/MAX([total_cases])' />
            </column>
            <column caption='Continent' datatype='string' name='[continent]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[location]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
              <aliases>
                <alias key='&quot;United Kingdom&quot;' value='U.K' />
                <alias key='&quot;United States&quot;' value='U.S' />
              </aliases>
              <semantic-values semantic-role='[Country].[Name]'>
                <semantic-value key='&quot;Micronesia (country)&quot;' value='&quot;Australia&quot;' />
              </semantic-values>
            </column>
            <column-instance column='[continent]' derivation='None' name='[none:continent:nk]' pivot='key' type='nominal' />
            <column caption='Population' datatype='integer' name='[population]' role='measure' type='quantitative' />
            <column caption='Total Cases' datatype='integer' name='[total_cases]' role='measure' type='quantitative' />
            <column caption='Total Deaths' datatype='integer' name='[total_deaths]' role='measure' type='quantitative' />
            <column caption='Total Vaccinations' datatype='integer' name='[total_vaccinations]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1214984083488771]' derivation='User' name='[usr:Calculation_1214984083488771:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1214984084344836]' derivation='User' name='[usr:Calculation_1214984084344836:qk]' pivot='key' type='quantitative' />
            <column-instance column='[date]' derivation='Year' name='[yr:date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1nblp2l1vnqjwq16ycivw16kzet4].[none:continent:nk]' filter-group='7'>
