        <zone flipboard-zone-id='5' forceUpdate='true' h='24556' hidden='true' id='6' story-point-id='1' type-v2='text' w='51000' x='24438' y='24111'>
          <formatted-text>
            <run bold='true' fontcolor='#a8073a' fontname='Georgia Pro Black' fontsize='20' underline='true'>Global COVID-19</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#a8073a' fontname='Georgia Pro Black' fontsize='20' underline='true'>Vaccination Tracker</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='37111' hidden='true' id='7' story-point-id='1' type-v2='text' w='48188' x='26625' y='52333'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Georgia' fontsize='15'>Capstone Portfolio Project: Data Analytics &amp; Visualization with Tableau</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Georgia' fontsize='15'>by </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Georgia' fontsize='15'>Nnennaya Ihekwoaba</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='15556' hidden='true' id='8' story-point-id='2' type-v2='text' w='53250' x='19250' y='31444'>
          <formatted-text>
            <run bold='true' fontcolor='#600421' fontname='Georgia' fontsize='18'>Executive Presentation</run>
            <run>Æ&#10;</run>
            <run bold='true' fontname='Georgia' fontsize='12'>Healthcare Analytics, Vaccine Equity and Execute level decision support</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='35111' hidden='true' id='9' story-point-id='2' type-v2='text' w='52813' x='19375' y='53667'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Georgia' fontsize='15'>Storyline</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#600421' fontname='Georgia'>1. Global baseline Measures</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#600421' fontname='Georgia'>2. Identifying Geographic Inequity</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#600421' fontname='Georgia'>3. Explaination of the Drivers</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#600421' fontname='Georgia'>4. Converting Insights to Actions and </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#600421' fontname='Georgia'>5. Final Reccomendations</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='41889' hidden='true' id='10' story-point-id='5' type-v2='text' w='67438' x='12938' y='48778'>
          <formatted-text>
            <run bold='true' fontcolor='#24262b' fontname='Georgia'>The dashboard shows a unified global picture: </run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#24262b' fontname='Georgia'>It brings cases, deaths, population, vaccination volume and country coverage into one view.</run>
            <run bold='true' fontcolor='#000000' fontname='Georgia'>Æ </run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#24262b' fontname='Georgia'>The Case fatality Rate is </run>
            <run bold='true' fontcolor='#f70b55' fontname='Georgia' fontsize='16'>&quot;1.15%&quot;</run>
            <run bold='true' fontcolor='#24262b' fontname='Georgia'> gives a quick global severity indicator, which is a measure of Deaths per confirmed Cases. </run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#24262b' fontname='Georgia'>While vaccination Rate is </run>
            <run bold='true' fontcolor='#f70b55' fontname='Georgia' fontsize='16'>&quot;44%&quot;</run>
            <run bold='true' fontcolor='#24262b' fontname='Georgia'> shows the scale of immunisation coverage relative to the population.</run>
            <run bold='true' fontcolor='#000000' fontname='Georgia'>Æ </run>
            <run>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='6444' hidden='true' id='11' story-point-id='6' type-v2='text' w='40188' x='19563' y='15444'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Georgia'>Global Map: Vaccination Disparity</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='39333' hidden='true' id='12' story-point-id='6' type-v2='text' w='21563' x='77938' y='42000'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Darker Colours indicate</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Æ </run>
            <run bold='true' fontcolor='#600421' fontname='Tableau Bold' fontsize='12'>higher Vaccination rates.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Lighter colours indicate </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#a8073a' fontname='Tableau Bold' fontsize='12'>lower Vaccination rates.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>This map also highlights each </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>each countries population,</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>GDP per capital,</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>Vaccination &amp; Booster rates</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='4444' hidden='true' id='13' story-point-id='8' type-v2='text' w='33938' x='5188' y='20667'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Georgia' fontsize='16'>Monthly Vaccination Trend</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='12000' hidden='true' id='14' story-point-id='8' type-v2='text' w='26875' x='5250' y='28556'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Georgia' fontsize='10'>Vaccination Rollout peaked in the month of June,</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Georgia' fontsize='10'>and was lesser in February and Octerber.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='4556' hidden='true' id='15' story-point-id='10' type-v2='text' w='39938' x='14188' y='16556'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='12'>Continent Vaccination and Case Fatality Rates</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='15889' hidden='true' id='16' story-point-id='10' type-v2='text' w='56500' x='16500' y='21333'>
          <formatted-text>
            <run bold='true' fontcolor='#600421' fontname='Georgia' fontsize='9'>South America, North America, Oceania &amp; Asia  show stronger vaccination coverage than Africa. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#600421' fontname='Georgia' fontsize='10'>Oceania shows strong relative outcomes, with comparatively low fatality rates. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#600421' fontname='Georgia' fontsize='10'>Africa combines the lowest continental vaccination rate of</run>
            <run bold='true' fontcolor='#f70b55' fontname='Georgia' fontsize='10'> &quot;9.3 %&quot;</run>
            <run bold='true' fontcolor='#600421' fontname='Georgia' fontsize='10'> and highest Case fatality rate of</run>
            <run bold='true' fontcolor='#f70b55' fontname='Georgia' fontsize='10'> &quot;2.52%&quot;</run>
            <run bold='true' fontcolor='#600421' fontname='Georgia' fontsize='10'>, which is higher than the glabal rate of</run>
            <run bold='true' fontcolor='#f70b55' fontname='Georgia' fontsize='10'> &quot; 44%&quot;</run>
            <run bold='true' fontcolor='#000000' fontname='Georgia' fontsize='10'>&amp;</run>
            <run bold='true' fontcolor='#f70b55' fontname='Georgia' fontsize='10'>&quot; 1.15%&quot; </run>
            <run bold='true' fontcolor='#000000' fontname='Georgia' fontsize='10'>respectively, </run>
            <run bold='true' fontcolor='#600421' fontname='Georgia' fontsize='10'> indicating a priority equity risk. </run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='5444' hidden='true' id='17' story-point-id='11' type-v2='text' w='48688' x='3063' y='14444'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#600421' fontname='Georgia' fontsize='12'>Bottom 10 Countries by Vaccination &amp; Case Fatality Rates</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='26556' hidden='true' id='18' story-point-id='11' type-v2='text' w='31375' x='57500' y='17556'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Georgia' fontsize='9'>Burundi, Yemen, Haiti, Papua New Guinea and Madagascar appear among the most urgent gaps in Vaccination Rates. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Georgia' fontsize='9'>Yamen indicates an urgent intervention following very poor vaccination rate of </run>
            <run bold='true' fontcolor='#f70b55' fontname='Georgia' fontsize='9'> &quot;</run>
            <run bold='true' fontcolor='#f70b55' fontname='Georgia' fontsize='10'>3.9</run>
            <run bold='true' fontcolor='#f70b55' fontname='Georgia' fontsize='9'>%&quot;</run>
            <run bold='true' fontcolor='#000000' fontname='Georgia' fontsize='9'>  and very high Case fatality rate of </run>
            <run bold='true' fontcolor='#f70b55' fontname='Georgia' fontsize='11'>&quot;18.1</run>
            <run bold='true' fontcolor='#f70b55' fontname='Georgia' fontsize='9'>%&quot;.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Georgia' fontsize='9'>Several countries also have elevated fatality, increasing the humanitarian risk of low coverage. </run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='5889' hidden='true' id='19' story-point-id='12' type-v2='text' w='40438' x='3875' y='16667'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#600421' fontname='Georgia'>GDP per Capital vs Vaccination Rates</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='16222' hidden='true' id='20' story-point-id='12' type-v2='text' w='47000' x='5563' y='22444'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Georgia' fontsize='12' underline='true'>Analysis</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#600421' fontname='Georgia' fontsize='10'>The scatterplot shows a positive relationship between GDP per capital and vaccination doses per person. In this extract, the correlation is about 0.59, meaning wealth is an important but incomplete driver of vaccine uptake. </run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='10222' hidden='true' id='21' story-point-id='12' type-v2='text' w='49938' x='7813' y='38889'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Georgia' fontsize='9' underline='true'>Recommendation</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#a8073a' fontname='Georgia' fontsize='9'>Use GDP as a targeting lens for advocacy and financing: lower-GDP countries may need subsidised procurement, logistics support and technical assistance, while outliers should be studied to identify replicable success factors. </run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='7778' id='22' story-point-id='14' type-v2='text' w='47813' x='14875' y='17111'>
          <formatted-text>
            <run bold='true' fontcolor='#600421' fontname='Georgia Pro Black' fontsize='15'>Final Executive Recommendations</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='9333' id='23' story-point-id='14' type-v2='text' w='70438' x='6063' y='26111'>
          <formatted-text>
            <run bold='true' fontcolor='#a8073a' fontname='Georgia' fontsize='12'>1. Prioritise vaccine equity by targeting countries with the lowest vaccination rate and highest fatality risk. </run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='9333' id='24' story-point-id='14' type-v2='text' w='70438' x='6125' y='37889'>
          <formatted-text>
            <run bold='true' fontcolor='#a8073a' fontname='Georgia' fontsize='12'>2. Use the monthly trend to detect rollout fatigue early and trigger booster/catch-up campaigns</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='12444' id='25' story-point-id='14' type-v2='text' w='70438' x='6250' y='49889'>
          <formatted-text>
            <run bold='true' fontcolor='#a8073a' fontname='Georgia' fontsize='12'>3.Combine GDP, population and fatality measures so donor support goes where affordability and health-system constraints are greatest. </run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='19444' id='26' story-point-id='14' type-v2='text' w='69875' x='6750' y='64333'>
          <formatted-text>
            <run bold='true' fontcolor='#a8073a' fontname='Georgia' fontsize='12'>4.</run>
            <run bold='true' fontcolor='#a8073a' fontname='Georgia' fontsize='11'> Allocate incremental NGO support to Africa first, especially countries with large populations and low coverage. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#a8073a' fontname='Georgia' fontsize='11'>Use fatality rate as a risk overlay so vaccine support is linked to lives saved, not just doses delivered. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#a8073a' fontname='Georgia' fontsize='11'>Build a continent-level scorecard for donor updates. </run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='3556' hidden='true' id='27' story-point-id='15' type-v2='text' w='37125' x='15813' y='15667'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia'>Top 10 Countries Cases &amp; Deaths</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='25556' hidden='true' id='28' story-point-id='15' type-v2='text' w='33313' x='48063' y='46778'>
          <formatted-text>
            <run bold='true' fontcolor='#600421' fontname='Tableau Bold' fontsize='12'>United States, China , India, France &amp; Brazil  have highest levels of Covid-19 Cases and relative Large Volume of Deaths.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#600421' fontname='Tableau Bold' fontsize='12'>These countries also have very large Population.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{A8B33ED9-CD38-4B46-8088-20421E9ED88B}' />
    </dashboard>
  </dashboards>
