    <dashboard name='STEPS' type='storyboard'>
      <style />
      <size maxheight='900' maxwidth='1600' minheight='900' minwidth='1600' preset-index='8' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98222' id='1' param='vert' removable='false' type-v2='layout-flow' w='99000' x='500' y='889'>
            <zone h='5556' id='3' type-v2='title' w='99000' x='500' y='889' />
            <zone h='11222' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99000' x='500' y='6445' />
            <zone h='81444' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99000' x='500' y='17667'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='STEPs' captured-sheet='' id='1' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='8889' id='6' story-point-id='1' type-v2='text' w='37125' x='1500' y='18222'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='12'>First : Data cleaned and Interpreter reviewed on Excel</run>
            <run fontalignment='0'>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='10111' id='7' story-point-id='1' type-v2='text' w='47500' x='1313' y='28000'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='12'>Created &quot;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='12' italic='true'>Latest Date&quot; </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='12'>  using Calculated Field, </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='12'>It returns the last date.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='12'>This helps to get the latest cummulative values</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='13556' id='8' story-point-id='1' type-v2='text' w='47500' x='1125' y='39222'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='10'>KPIs</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='10'>Added &quot;Latest Date to filter,</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='10'>Drag and droped my respective &quot;Total Cases&quot; &amp; &quot;Total Deaths&quot;.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='10'>Found the Max(Total Cases) &amp; ..</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='10'>This reflects the Cummulative Total Values</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='12667' id='9' story-point-id='1' type-v2='text' w='47188' x='1375' y='54222'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='12'>Country Grouping (</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='12' italic='true'>using calc. field)</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='11'>Since Actual Countries have only 3-letter ISO codes</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='11'>This is to distinguish and group Countries from others.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='10' italic='true'>IF LEFT([</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='10'>Iso Code</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Georgia' fontsize='10' italic='true'>],4)= &quot;OWID&quot; THEN &quot;Other Regions&quot; ELSE &quot;Country&quot; END</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='14222' id='10' story-point-id='1' type-v2='text' w='47750' x='1313' y='67667'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontname='Georgia' fontsize='12'>Draged and Droped &quot;Location&quot; to column, and</run>
            <run bold='true' fontalignment='0' fontname='Georgia' fontsize='12' italic='true' underline='true'> Sum</run>
            <run bold='true' fontalignment='0' fontname='Georgia' fontsize='12'> of </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontname='Georgia' fontsize='12'>&quot;New Cases&quot; &amp; &quot;New Deaths&quot; to Rows</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontname='Georgia' fontsize='12'>Also drop &quot;Country Grouping&quot; to Filter , exclude &quot;Not Valid&quot;</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontname='Georgia' fontsize='12'>Also Select Top 10 from Location.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{DA188579-E117-483F-BE37-DBB5778DD151}' />
    </dashboard>
